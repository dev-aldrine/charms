# Joy's Fairy Charms - Server Environment Variables

# Brevo (formerly Sendinblue) Transactional Email API
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Verified sender email in your Brevo account (Senders & IP settings)
BREVO_SENDER_EMAIL=joy@joysfairycharms.com
BREVO_SENDER_NAME="Joy's Fairy Charms Atelier"

# MongoDB Database Connection (when ready)
MONGODB_URI=

# Port for local Express server
PORT=5000
